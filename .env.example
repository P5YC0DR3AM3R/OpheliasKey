# ---------------------------------------------------------------------------
# Ophelia's Key — configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

OKEY_DB_PATH=data/opheliaskey.db
OKEY_RAW_DIR=data/raw
OKEY_LOG_LEVEL=INFO

# --- Gmail -----------------------------------------------------------------
# OAuth desktop-app client from console.cloud.google.com with the Gmail API
# enabled. Scope needed: https://www.googleapis.com/auth/gmail.readonly
OKEY_GMAIL_CLIENT_SECRET_FILE=secrets/gmail_client_secret.json
OKEY_GMAIL_TOKEN_FILE=secrets/gmail_token.json
# Only ingest mail at or after this date (project start).
OKEY_GMAIL_SINCE=2024-01-01

# --- Amazon Business -------------------------------------------------------
# Login with Amazon (LWA) credentials from your Amazon Business developer app.
# Requires an approved Amazon Business API integration on the account.
OKEY_AMAZON_CLIENT_ID=
OKEY_AMAZON_CLIENT_SECRET=
OKEY_AMAZON_REFRESH_TOKEN=
OKEY_AMAZON_REGION=na
# Fallback path: Retail.OrderHistory.csv from Amazon's "Request My Data" portal
OKEY_AMAZON_CSV_DIR=data/imports/amazon

# --- Plaid -----------------------------------------------------------------
OKEY_PLAID_CLIENT_ID=
OKEY_PLAID_SECRET=
OKEY_PLAID_ENV=sandbox
# Populated by `okey plaid link` after connecting an institution.
OKEY_PLAID_ACCESS_TOKEN=
